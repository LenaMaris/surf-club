---
import MainLayout from '../../layouts/MainLayout.astro';
import { translations } from '../../i18n';

// Statically set the language (change to 'pt' to test Portuguese)
const lang = 'en';
const t = translations[lang];

const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'];

// --- SCHEDULE DATA ---
const schedule = {
  monday: [
    { time: '08h00 - 10h00', name: t.community_hours },
    { time: '14h00 - 16h00', name: t.tutoring_math },
    { time: '16h30 - 17h30', name: t.jiu_jitsu },
    { time: '17h30 - 19h00', name: t.jiu_jitsu },
    { time: '19h00 - 21h00', name: t.jiu_jitsu_adults }
  ],
  tuesday: [
    { time: '08h00 - 10h00', name: t.community_hours },
    { time: '14h00 - 15h00', name: t.free_surf },
    { time: '15h00 - 18h00', name: t.surf_bodyboard },
    { time: '18h00 - 19h30', name: t.ballet }
  ],
  wednesday: [
    { time: '08h00 - 11h30', name: t.legal_advice },
    { time: '14h00 - 16h00', name: t.tutoring_portuguese },
    { time: '17h00 - 19h00', name: t.jiu_jitsu },
    { time: '19h00 - 21h00', name: t.jiu_jitsu_adults }
  ],
  thursday: [
    { time: '08h00 - 11h00', name: t.community_hours },
    { time: '14h00 - 15h00', name: t.free_surf },
    { time: '15h00 - 18h00', name: t.surf_bodyboard },
    { time: '18h00 - 19h30', name: t.ballet },
    { time: '20h00 - 22h00', name: t.jiu_jitsu_adults }
  ],
  friday: [
    { time: '16h30 - 17h30', name: t.jiu_jitsu }
  ]
};

const maxClasses = Math.max(...days.map(day => schedule[day as keyof typeof schedule].length));
const rows = Array.from({ length: maxClasses }, (_, i) => i);

// --- NEW: CLASS DETAILS DATA ---
// You can edit all the text and image paths right here!
const classDetails = [
  {
    title: t.community_hours, 
    image: '/images/community_hours.jpg', 
    professors: 'Filhos de Mãe Luiza Team',
    description: 'Our doors are always open to the neighborhood. In the mornings, we welcome Mãe Luiza families, visitors, and partners for a time of listening, support, and overall community integration.'
  },
  {
    title: t.tutoring,
    image: '/images/tutoring.jpg',
    professors: 'Prof. Seabra',
    description: 'We know that sports alone are not enough; education is the foundation. Our volunteer teachers provide afternoon tutoring to make sure no one falls behind in school, helping to combat illiteracy and encourage a love for studying.'
  },
  {
    title: t.jiu_jitsu,
    image: '/images/jiu-jitsu.jpg',
    professors: 'Prof. David and Prof. Nelino',
    description: 'The mat changes the story of our youth. We host our own classes alongside the ROX BJJ team, which trains over 80 students. We have sessions almost every day: the kids train in the late afternoon, starting around 4:30 PM, split across different rooms. Meanwhile, the adult group trains hard in the evening, from 7:00 PM to 9:00 PM, on Mondays, Wednesdays, and Thursdays.'
  },
  {
    title: t.free_surf,
    image: '/images/free-surf.jpg',
    professors: 'Prof. Ventura',
    description: 'Before hitting the water, we sit down to talk. This is an essential time where we teach general knowledge and life philosophy. Here, we show them that the right path is through sports and education, keeping our youth off the streets.'
  },
  {
    title: t.surf_bodyboard,
    image: '/images/surf-bodyboard.jpg',
    professors: 'Prof. Nelino, Prof. Ivanildo, Prof. João Vitor, and Volunteers',
    description: 'Our true classroom: the ocean at Miami Beach. During the afternoon, we teach wave maneuvers, but we also handle physical preparation on the sand, ocean reading, and hold open talks about environmental preservation and citizenship.'
  },
  {
    title: t.ballet,
    image: '/images/ballet.jpg',
    professors: 'Prof. Anaclecia and Prof. Ana Karolina',
    description: 'We proudly serve 40 girls from our community. Students are divided by age and level into Baby I, Baby II, and 1st Year groups. We meet on Tuesdays and Thursdays in the early evening (from 6:00 PM to 7:30 PM). Ballet builds the self-esteem of the girlsand strengthens the incredible bonds with their mothers, who watch every step closely.'
  },
  {
    title: t.legal_advice,
    image: '/images/legal-advice.jpg',
    professors: 'Volunteer Lawyers',
    description: 'Often, families in our neighborhood have nowhere to turn for help. That’s why, on Wednesday mornings, we provide a space for volunteer lawyers to offer free legal guidance and help secure the rights of our community.'
  }
];
---

<MainLayout title={t.classes_title} lang={lang}>
  <section class="classes-container">
    
    <h2 class="section-title-small" style="text-align: center; margin-top: 60px;">
      {t.classes_title}
    </h2>

    <div class="table-scroll-wrapper">
      <table class="schedule-table-horizontal">
        <thead>
          <tr>
            {days.map((day) => (
              <th style="background-color: var(--navy); color: white; padding: 25px; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; font-weight: 800; text-align: center;">
                {t[day as keyof typeof t]}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((rowIndex) => (
            <tr>
              {days.map((day) => {
                const cls = schedule[day as keyof typeof schedule][rowIndex];
                return (
                  <td style="padding: 20px; text-align: center; border: 1px solid #f0f0f0; vertical-align: middle;">
                    {cls ? (
                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <span style="font-family: 'Courier New', Courier, monospace; font-weight: 600; color: #666; font-size: 0.85rem;">
                          {cls.time}
                        </span>
                        <span style="color: var(--cyan); font-weight: 800; font-size: 1.05rem;">
                          {cls.name}
                        </span>
                      </div>
                    ) : (
                      <span style="color: #ccc;">-</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="section-title-small" style="text-align: center; margin-top: 100px;">
      About Our Classes
    </h2>
    
    <div class="class-cards-grid">
      {classDetails.map((info) => (
        <div class="class-card">
          <div class="class-img-wrapper">
            <img src={info.image} alt={info.title} class="class-img" onerror="this.style.display='none'" />
          </div>
          
          <div class="class-card-content">
            <h3>{info.title}</h3>
            <span class="professors">{info.professors}</span>
            <p>{info.description}</p>
          </div>
        </div>
      ))}
    </div>

  </section>
</MainLayout>

<style>
  .class-cards-grid {
    display: grid;
    /* This automatically makes it 1 column on phones, 2 on tablets, and 3 on big screens! */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
    margin-bottom: 100px;
  }

  .class-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 43, 92, 0.08); /* Matches your project's shadow vibe */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .class-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 43, 92, 0.15);
  }

  .class-img-wrapper {
    width: 100%;
    height: 220px;
    background-color: #eaeaea; /* Light gray placeholder until you add real images */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .class-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .class-card-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .class-card-content h3 {
    color: var(--navy);
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .professors {
    color: var(--cyan);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    border-bottom: 2px solid var(--yellow); /* Adds that cool surfboard yellow touch */
    padding-bottom: 8px;
    display: inline-block;
    align-self: flex-start;
  }

  .class-card-content p {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>