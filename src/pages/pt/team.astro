---
import MainLayout from '../../layouts/MainLayout.astro';
import { translations } from '../../i18n';

// Change to 'pt' when copying to the Portuguese folder
const lang = 'pt'; 
const t = translations[lang as keyof typeof translations];
const base = `/${lang}`;

// --- TEAM MEMBERS DATA ---
// We pull the roles and descriptions directly from the translation file!
const teamMembers = [
  {
    name: 'Francisco Ventura Pereira Filho',
    role: t.role_francisco,
    image: '/images/francisco.jpg',
    description: t.desc_francisco
  },
  {
    name: 'Edileide Teixeira ("Baixinha")',
    role: t.role_edileide,
    image: '/images/baixinha.jpg',
    description: t.desc_edileide
  },
  {
    name: 'Haroldo Chaves',
    role: t.role_haroldo,
    image: '/images/haroldo.jpg',
    description: t.desc_haroldo
  },
  {
    name: 'Wagner Pereira',
    role: t.role_wagner,
    image: '/images/wagner.jpg',
    description: t.desc_wagner
  },
  {
    name: 'Nelino Costa ("Mussum")',
    role: t.role_nelino,
    image: '/images/mussum.jpg',
    description: t.desc_nelino
  },
  {
    name: 'Ivanildo Silva',
    role: t.role_ivanildo,
    image: '/images/ivanildo.jpg',
    description: t.desc_ivanildo
  },
  {
    name: 'Alexandre Santana ("Velho")',
    role: t.role_alexandre,
    image: '/images/alexandre.jpg',
    description: t.desc_alexandre
  }
];
---

<MainLayout title={t.team} lang={lang}>
  
  <section class="history-section">
    <h2 class="section-title-small" style="text-align: center; margin-top: 60px;">
      {t.history_title}
    </h2>
    <div class="history-content">
      <p>{t.history_p1}</p>
      <p>{t.history_p2}</p>
      <p>{t.history_p3}</p>
    </div>
  </section>

  <section class="team-section">
    <h2 class="section-title-small" style="text-align: center; margin-top: 80px;">
      {t.team_grid_title}
    </h2>
    
    <!-- THE FOUNDER (Wider, Centered Card) -->
    <div class="founder-container">
      <div class="team-card founder-card">
        <div class="team-img-wrapper">
          <!-- teamMembers[0] is Francisco -->
          <img src={teamMembers[0].image} alt={teamMembers[0].name} class="team-img" onerror="this.style.display='none'" />
        </div>
        <div class="team-card-content">
          <h3 class="member-name">{teamMembers[0].name}</h3>
          <span class="member-role">{teamMembers[0].role}</span>
          <p class="member-desc">{teamMembers[0].description}</p>
        </div>
      </div>
    </div>

    <!-- THE REST OF THE TEAM (3x3 Grid) -->
    <div class="team-grid">
      <!-- .slice(1) skips the first person (Francisco) and loops through the rest -->
      {teamMembers.slice(1).map((member) => (
        <div class="team-card">
          <div class="team-img-wrapper">
            <img src={member.image} alt={member.name} class="team-img" onerror="this.style.display='none'" />
          </div>
          <div class="team-card-content">
            <h3 class="member-name">{member.name}</h3>
            <span class="member-role">{member.role}</span>
            <p class="member-desc">{member.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="volunteer-cta">
    <h2>{t.cta_volunteer_title}</h2>
    <a href={`${base}/help-us#volunteer`} class="cta-button">
      {t.cta_volunteer_btn}
    </a>
  </section>

</MainLayout>

<style>
  .history-section { max-width: 800px; margin: 0 auto; padding: 0 20px; }
  .history-content { display: flex; flex-direction: column; gap: 20px; margin-top: 30px; }
  .history-content p { font-size: 1.1rem; color: #444; line-height: 1.8; text-align: justify; }

  //* --- FOUNDER CARD STYLES --- */
  /* --- FOUNDER CARD STYLES --- */
  .founder-container {
    display: flex;
    justify-content: center;
    margin: 40px auto 50px auto;
    padding: 0 20px;
  }

  .founder-card {
    background: white; 
    border-radius: 15px; 
    overflow: hidden; 
    box-shadow: 0 10px 30px rgba(0, 43, 92, 0.08); 
    transition: transform 0.3s ease;
    display: flex; 
    flex-direction: row;
    align-items: stretch;
    
    /* THE BULLETPROOF FIX: */
    width: 100%;
    max-width: 750px; /* Change this number to make the box wider or narrower! */
    margin: 0 auto; /* Keeps it dead center */
  }

  .founder-card:hover { transform: translateY(-5px); }

  .founder-card .team-img-wrapper {
    flex: 0 0 40%; 
    min-width: 250px; 
    display: flex; /* Helps the image fill the container */
  }

  .founder-card .team-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block; /* Removes default image spacing */
  }

  .founder-card .team-card-content {
    flex: 1; 
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left; /* Overrides center alignment */
  }

  .founder-card .member-desc {
    text-align: justify; /* Makes the text stretch evenly to both edges of the box */
  }


  /* --- REST OF THE TEAM GRID STYLES --- */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); 
    gap: 40px; 
    margin-bottom: 80px;
    max-width: 1200px; 
    margin-left: auto; 
    margin-right: auto;
    padding: 0 20px;
  }

  .team-card { 
    background: white; 
    border-radius: 15px; 
    overflow: hidden; 
    box-shadow: 0 10px 30px rgba(0, 43, 92, 0.08); 
    transition: transform 0.3s ease; 
    text-align: center; 
    display: flex;
    flex-direction: column;
  }
  
  .team-card:hover { transform: translateY(-5px); }
  
  .team-img-wrapper { 
    width: 100%; 
    height: 300px; 
    background-color: #eaeaea; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
  }
  
  .team-img { width: 100%; height: 100%; object-fit: cover; }
  .team-card-content { padding: 25px 20px; flex-grow: 1; }

  /* Shared Text Styles */
  .member-name { color: var(--navy); font-size: 1.4rem; margin-bottom: 5px; }
  .member-role { display: block; color: var(--cyan); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; }
  .member-desc { color: #555; font-size: 0.95rem; line-height: 1.6; }

  /* --- MOBILE RESPONSIVENESS --- */
  @media (max-width: 900px) {
    /* Stack the founder card vertically on phones/tablets */
    .founder-card {
      flex-direction: column;
      text-align: left; /* FIX: Keeps text aligned to the edges instead of centering! */
    }
    .founder-card .team-img-wrapper {
      width: 100%;
      height: 350px; /* Gives the image a nice solid height */
      flex: none;
    }
    .founder-card .team-card-content {
      width: 100%;
      padding: 30px 25px;
    }
    
    /* Allow the 3x3 grid to collapse */
    .team-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
    }
  }

  /* --- VOLUNTEER CTA STYLES --- */
  .volunteer-cta {
    background-color: rgba(14, 34, 60, 0.95); 
    color: white; 
    text-align: center;
    padding: 60px 20px; 
    border-radius: 15px; 
    max-width: 1000px;
    margin: 0 auto 100px; 
    box-shadow: 0 20px 40px rgba(0, 43, 92, 0.2);
  }

  .volunteer-cta h2 { 
    color: white; 
    font-size: 2.2rem; 
    margin-bottom: 15px; 
  }

  .volunteer-cta p { 
    font-size: 1.1rem; 
    margin-bottom: 30px; 
    color: #e0e0e0; 
  }

  .cta-button {
    display: inline-block; 
    background-color: var(--cyan); 
    color: white; 
    font-weight: 800; 
    text-transform: uppercase; 
    letter-spacing: 1px;
    padding: 15px 35px; 
    border-radius: 30px; 
    text-decoration: none; 
    transition: all 0.3s ease;
  }

  .cta-button:hover { 
    background-color: white; 
    color: var(--cyan); 
    transform: scale(1.05); 
  }
</style>