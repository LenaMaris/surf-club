---
import MainLayout from '../../layouts/MainLayout.astro';
import { translations } from '../../i18n';

// Change to 'pt' when copying to the Portuguese folder
const lang = 'pt'; 
const t = translations[lang as keyof typeof translations];
const base = `/${lang}`;

// --- TEAM MEMBERS DATA ---
// We pull the roles and descriptions directly from the translation file!
const teamMembers = [
  {
    name: 'Francisco Ventura Pereira Filho',
    role: t.role_francisco,
    image: '/images/francisco.jpg',
    description: t.desc_francisco
  },
  {
    name: 'Edileide Teixeira ("Baixinha")',
    role: t.role_edileide,
    image: '/images/baixinha.jpg',
    description: t.desc_edileide
  },
  {
    name: 'Haroldo Chaves',
    role: t.role_haroldo,
    image: '/images/haroldo.jpg',
    description: t.desc_haroldo
  },
  {
    name: 'Wagner Pereira',
    role: t.role_wagner,
    image: '/images/wagner.jpg',
    description: t.desc_wagner
  },
  {
    name: 'Nelino Costa ("Mussum")',
    role: t.role_nelino,
    image: '/images/mussum.jpg',
    description: t.desc_nelino
  },
  {
    name: 'Ivanildo Silva',
    role: t.role_ivanildo,
    image: '/images/ivanildo.jpg',
    description: t.desc_ivanildo
  },
  {
    name: 'Alexandre Santana ("Velho")',
    role: t.role_alexandre,
    image: '/images/alexandre.jpg',
    description: t.desc_alexandre
  }
];
---

<MainLayout title={t.team} lang={lang}>
  
  <section class="history-section">
    <h2 class="section-title-small" style="text-align: center; margin-top: 60px;">
      {t.history_title}
    </h2>
    <div class="history-content">
      <p>{t.history_p1}</p>
      <p>{t.history_p2}</p>
    </div>
  </section>

  <section class="team-section">
    <h2 class="section-title-small" style="text-align: center; margin-top: 80px;">
      {t.team_grid_title}
    </h2>
    
    <div class="team-grid">
      {teamMembers.map((member) => (
        <div class="team-card">
          <div class="team-img-wrapper">
            <img src={member.image} alt={member.name} class="team-img" onerror="this.style.display='none'" />
          </div>
          <div class="team-card-content">
            <h3 class="member-name">{member.name}</h3>
            <span class="member-role">{member.role}</span>
            <p class="member-desc">{member.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="volunteer-cta">
    <h2>{t.cta_volunteer_title}</h2>
    <p>{t.cta_volunteer_desc}</p>
    <a href={`${base}/help-us#volunteer`} class="cta-button">
      {t.cta_volunteer_btn}
    </a>
  </section>

</MainLayout>

<style>
  .history-section { max-width: 800px; margin: 0 auto; padding: 0 20px; }
  .history-content { display: flex; flex-direction: column; gap: 20px; margin-top: 30px; }
  .history-content p { font-size: 1.1rem; color: #444; line-height: 1.8; text-align: justify; }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px; margin-top: 50px; margin-bottom: 80px;
    max-width: 1200px; margin-left: auto; margin-right: auto;
  }
  .team-card { background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 43, 92, 0.08); transition: transform 0.3s ease; text-align: center; }
  .team-card:hover { transform: translateY(-5px); }
  .team-img-wrapper { width: 100%; height: 300px; background-color: #eaeaea; display: flex; align-items: center; justify-content: center; }
  .team-img { width: 100%; height: 100%; object-fit: cover; }
  .team-card-content { padding: 25px 20px; }
  .member-name { color: var(--navy); font-size: 1.4rem; margin-bottom: 5px; }
  .member-role { display: block; color: var(--cyan); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; }
  .member-desc { color: #555; font-size: 0.95rem; line-height: 1.6; }

  .volunteer-cta {
    /* Updated to match your beautiful footer color! */
    background-color: rgba(14, 34, 60, 0.95); 
    color: white; 
    text-align: center;
    padding: 60px 20px; 
    border-radius: 15px; 
    max-width: 1000px;
    margin: 0 auto 100px; 
    box-shadow: 0 20px 40px rgba(0, 43, 92, 0.2);
  }

  .volunteer-cta h2 { 
    color: white; 
    font-size: 2.2rem; 
    margin-bottom: 15px; 
  }

  .volunteer-cta p { 
    font-size: 1.1rem; 
    margin-bottom: 30px; 
    color: #e0e0e0; 
  }

  .cta-button {
    display: inline-block; 
    /* Changed from Yellow to your brand's Cyan */
    background-color: var(--cyan); 
    color: white; /* Clean white text */
    font-weight: 800; 
    text-transform: uppercase; 
    letter-spacing: 1px;
    padding: 15px 35px; 
    border-radius: 30px; 
    text-decoration: none; 
    transition: all 0.3s ease;
  }

  .cta-button:hover { 
    background-color: white; 
    color: var(--cyan); /* Text turns blue when the button turns white */
    transform: scale(1.05); 
  }
</style>