---

<MainLayout title={t.gallery} lang={lang}>
  
  <section class="gallery-intro">
    <h2 class="section-title-small" style="text-align: center; margin-top: 60px;">
      {t.gallery_page_title}
    </h2>
    <p style="text-align: center; max-width: 700px; margin: 20px auto 60px; font-size: 1.1rem; color: #555;">
      {t.gallery_page_intro}
    </p>
  </section>

  <!-- PHOTOS SECTION -->
  <section class="gallery-section">
    <div class="section-header">
      <h3>{t.photos_title}</h3>
      <div class="yellow-divider"></div>
    </div>
    
    <div class="photo-grid">
      {photos.map((photo) => (
        <div class="media-card photo-card">
          <img src={photo} alt="Filhos de Mãe Luiza Gallery Photo" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- LOCAL VIDEOS SECTION -->
  <section class="gallery-section">
    <div class="section-header">
      <h3>{t.videos_title}</h3>
      <div class="yellow-divider"></div>
    </div>
    
    <div class="video-grid">
      {videos.map((video) => {
        // This logic takes "/videos/video-1.mp4" 
        // and turns it into "/videos/screen-1.jpg" automatically
        const posterPath = video.replace('video-', 'screen-').replace('.mp4', '.jpg');

        return (
          <div class="media-card video-card">
            <video controls preload="none" poster={posterPath}>
              <source src={video} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        );
      })}
    </div>
  </section>

  <!-- YOUTUBE SECTION -->
  <section class="gallery-section" style="margin-bottom: 100px;">
    <div class="section-header">
      <h3>{t.youtube_title}</h3>
      <div class="yellow-divider"></div>
    </div>
    
    <div class="youtube-grid">
      {youtubeLinks.map((link) => (
        <div class="media-card youtube-card">
          <iframe 
          src={link} 
          title="YouTube video player" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
          loading="lazy"
        ></iframe>
        </div>
      ))}
    </div>
  </section>

</MainLayout>

<style>
  .gallery-section {
    max-width: 1400px;
    margin: 0 auto 80px;
    padding: 0 20px;
  }

  .section-header {
    margin-bottom: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header h3 {
    color: var(--navy);
    font-size: 2rem;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .yellow-divider {
    width: 60px;
    height: 4px;
    background-color: var(--yellow);
  }

  /* Improved Media Card */
  .media-card {
    background: #eaeaea;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 43, 92, 0.1);
    transition: all 0.3s ease;
    position: relative;
  }

  .media-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 43, 92, 0.2);
  }

  /* Photo Grid - Modern Masonry-like feel */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    grid-auto-rows: 300px;
    gap: 20px;
  }

  .photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Video Grid - Wider cards for impact */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 30px;
  }

  .video-card {
    aspect-ratio: 16 / 9; /* Cinematic ratio for videos */
  }

  .video-card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* YouTube Grid */
  .youtube-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 30px;
  }

  .youtube-card {
    aspect-ratio: 16 / 9;
  }

  .youtube-card iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .video-grid, .youtube-grid {
      grid-template-columns: 1fr;
    }
    .photo-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      grid-auto-rows: 200px;
    }
  }
</style>