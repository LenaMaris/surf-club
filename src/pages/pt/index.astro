---
// Go up TWO levels: out of 'pt', then out of 'pages' to reach 'src'
import { translations } from "../../i18n";
import '../../styles/global.css';
import MainLayout from '../../layouts/MainLayout.astro';

// Statically set the language since this is the /pt/ folder
const lang = "pt";
const t = translations[lang];
---

<MainLayout title="Home" lang={lang}>
  
  <section class="hero-logo-container">
    <img src="/logo.PNG" alt="Filhos de Mãe Luiza Logo" class="hero-logo-big" />
    <h1 class="hero-title">{t.hero_title}</h1>
    <p class="hero-subtitle">{t.hero_subtitle}</p>
  </section>

  <section class="intro-section">
    <div class="intro-body-single">
      <p class="about-summary">{t.about_summary}</p>
      <p>{t.about_p1}</p>
    </div>
  </section>

  <section class="photo-grid-container">
    <div class="photo-grid">
      <div class="grid-item item-1"><img src="/images/photo-1.jpg" alt="Surf 1" /></div>
      <div class="grid-item item-2"><img src="/images/photo-2.jpg" alt="Surf 2" /></div>
      <div class="grid-item item-3"><img src="/images/photo-3.jpg" alt="Surf 3" /></div>
      <div class="grid-item item-4"><img src="/images/photo-4.jpg" alt="Surf 4" /></div>
      <div class="grid-item item-5"><img src="/images/photo-5.jpg" alt="Surf 5" /></div>
      <div class="grid-item item-6"><img src="/images/photo-6.jpg" alt="Surf 6" /></div>
      <div class="grid-item item-7"><img src="/images/photo-7.jpg" alt="Surf 7" /></div>
    </div>
  </section>
</MainLayout>

<style>
  .photo-grid-container {
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
  }

  /* The Collage Layout Grid */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* Divides the space into 3 equal columns */
    grid-auto-rows: 250px; /* Sets a base height for the rows */
    gap: 20px;
  }

  /* Base styling for all items */
  .grid-item {
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 43, 92, 0.1);
  }

  .grid-item img {
    width: 100%;
    height: 100%;
    /* This rule is the magic that makes sizes not matter! */
    object-fit: cover; 
    display: block;
    transition: transform 0.3s ease;
  }


  /* --- THE COLLAGE SHAPES FOR 7 ITEMS --- */
  
  /* Big Square (Top Left) */
  .item-1 {
    grid-column: 1 / 3; /* Spans 2 columns wide */
    grid-row: 1 / 3;    /* Spans 2 rows tall */
  }
  
  /* Regular Square (Top Right) */
  .item-2 {
    grid-column: 3 / 4; 
    grid-row: 1 / 2;
  }
  
  /* Regular Square (Middle Right) */
  .item-3 {
    grid-column: 3 / 4;
    grid-row: 2 / 3;
  }
  
  /* Tall Vertical Photo (Bottom Left) */
  .item-4 {
    grid-column: 1 / 2;
    grid-row: 3 / 5;    /* Spans 2 rows tall */
  }
  
  /* Wide Horizontal Photo (Middle) */
  .item-5 {
    grid-column: 2 / 4; /* Spans 2 columns wide */
    grid-row: 3 / 4;
  }
  
  /* Regular Square (Bottom Middle) */
  .item-6 {
    grid-column: 2 / 3;
    grid-row: 4 / 5;
  }
  
  /* Regular Square (Bottom Right) */
  .item-7 {
    grid-column: 3 / 4;
    grid-row: 4 / 5;
  }

  /* --- MOBILE RESPONSIVENESS --- */
  /* On phone screens, the collage would be too squished, so we stack them normally */
  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: 1fr; /* Changes to 1 single column */
      grid-auto-rows: 300px; /* Gives each photo a nice standard height */
    }
    
    /* This resets all the special shapes above so they just line up neatly */
    .item-1, .item-2, .item-3, .item-4, .item-5, .item-6, .item-7 {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>