---
import MainLayout from '../../layouts/MainLayout.astro';
import { translations } from '../../i18n';

// Statically set the language (change to 'pt' to test Portuguese)
const lang = 'pt';
const t = translations[lang];

const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'];

// --- SCHEDULE DATA ---
const schedule = {
  monday: [
    { time: '08h00 - 10h00', name: t.community_hours },
    { time: '14h00 - 16h00', name: t.tutoring_math },
    { time: '16h30 - 17h30', name: t.jiu_jitsu },
    { time: '17h30 - 19h00', name: t.jiu_jitsu },
    { time: '19h00 - 21h00', name: t.jiu_jitsu_adults }
  ],
  tuesday: [
    { time: '08h00 - 10h00', name: t.community_hours },
    { time: '14h00 - 15h00', name: t.free_surf },
    { time: '15h00 - 18h00', name: t.surf_bodyboard },
    { time: '18h00 - 19h30', name: t.ballet }
  ],
  wednesday: [
    { time: '08h00 - 11h30', name: t.legal_advice },
    { time: '14h00 - 16h00', name: t.tutoring_portuguese },
    { time: '17h00 - 19h00', name: t.jiu_jitsu },
    { time: '19h00 - 21h00', name: t.jiu_jitsu_adults }
  ],
  thursday: [
    { time: '08h00 - 11h00', name: t.community_hours },
    { time: '14h00 - 15h00', name: t.free_surf },
    { time: '15h00 - 18h00', name: t.surf_bodyboard },
    { time: '18h00 - 19h30', name: t.ballet },
    { time: '20h00 - 22h00', name: t.jiu_jitsu_adults }
  ],
  friday: [
    { time: '16h30 - 17h30', name: t.jiu_jitsu }
  ]
};

const maxClasses = Math.max(...days.map(day => schedule[day as keyof typeof schedule].length));
const rows = Array.from({ length: maxClasses }, (_, i) => i);

// --- NEW: CLASS DETAILS DATA ---
// You can edit all the text and image paths right here!
const classDetails = [
  {
    title: t.community_hours, 
    image: '/images/community_hours.jpg', 
    professors: 'Equipe Filhos de Mãe Luiza',
    description: 'Nossas portas estão sempre abertas para o bairro. Pela manhã, recebemos as famílias de Mãe Luiza, visitantes e parceiros para um momento de acolhimento, escuta e integração geral com a comunidade.'
  },
  {
    title: t.tutoring,
    image: '/images/tutoring.jpg',
    professors: 'Prof. ? (Matemática) e Prof. Seabra (Português)',
    description: 'A gente sabe que só o esporte não basta; a base de tudo é a educação. Nossos professores voluntários dão aulas de reforço no período da tarde para garantir que ninguém fique para trás na escola, ajudando a combater o analfabetismo e incentivando o estudo.'
  },
  {
    title: t.jiu_jitsu,
    image: '/images/jiu-jitsu.jpg',
    professors: 'Prof. David e Prof. Nelino',
    description: 'O tatame muda a história da nossa juventude. O projeto abriga turmas próprias e também a equipe ROX BJJ, que atende mais de 80 alunos. Temos aulas quase todos os dias: a garotada treina no final da tarde, a partir das 16h30, dividida em várias salas. Já a turma dos adultos pega pesado no período da noite, das 19h às 21h, nas segundas, quartas e quintas.'
  },
  {
    title: t.free_surf,
    image: '/images/free-surf.jpg',
    professors: 'Prof. Ventura',
    description: 'Antes de cair na água, a gente senta para conversar. É um momento essencial onde damos aulas de conhecimentos gerais e filosofia de vida. Aqui ensinamos que o caminho é o esporte e a educação, mantendo nossos jovens longe das ruas.'
  },
  {
    title: t.surf_bodyboard,
    image: '/images/surf-bodyboard.jpg',
    professors: 'Prof. Nelino, Prof. Ivanildo, Prof. João Vitor e Voluntários',
    description: 'A nossa verdadeira sala de aula: o mar da Praia de Miami. Durante a tarde, ensinamos as manobras na água, mas também fazemos toda a preparação física na areia, leitura do mar e rodas de conversa sobre preservação e cidadania.'
  },
  {
    title: t.ballet,
    image: '/images/ballet.jpg',
    professors: 'Prof. Anaclecia e Prof. Ana Karolina',
    description: 'Atendemos com muito orgulho 40 meninas da comunidade. As alunas são divididas por nível e idade nas turmas Baby I, Baby II e 1º Ano. Nossos encontros acontecem às terças e quintas-feiras, no comecinho da noite (de 18h às 19h30). O ballet constrói a autoestima das meninas e fortalece o laço incrível com as mães, que acompanham cada passo de perto.'
  },
  {
    title: t.legal_advice,
    image: '/images/legal-advice.jpg',
    professors: 'Advogados Voluntários',
    description: 'Muitas vezes, as famílias do nosso bairro não têm a quem recorrer. Por isso, nas quartas-feiras pela manhã, abrimos espaço para que advogados voluntários ofereçam orientação gratuita e ajudem a garantir os direitos da nossa comunidade.'
  }
];
---

<MainLayout title={t.classes_title} lang={lang}>
  <section class="classes-container">
    
    <h2 class="section-title-small" style="text-align: center; margin-top: 60px;">
      {t.classes_title}
    </h2>

    <div class="table-scroll-wrapper">
      <table class="schedule-table-horizontal">
        <thead>
          <tr>
            {days.map((day) => (
              <th style="background-color: var(--navy); color: white; padding: 25px; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; font-weight: 800; text-align: center;">
                {t[day as keyof typeof t]}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((rowIndex) => (
            <tr>
              {days.map((day) => {
                const cls = schedule[day as keyof typeof schedule][rowIndex];
                return (
                  <td style="padding: 20px; text-align: center; border: 1px solid #f0f0f0; vertical-align: middle;">
                    {cls ? (
                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <span style="font-family: 'Courier New', Courier, monospace; font-weight: 600; color: #666; font-size: 0.85rem;">
                          {cls.time}
                        </span>
                        <span style="color: var(--cyan); font-weight: 800; font-size: 1.05rem;">
                          {cls.name}
                        </span>
                      </div>
                    ) : (
                      <span style="color: #ccc;">-</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="section-title-small" style="text-align: center; margin-top: 100px;">
      Sobre Nossas Aulas
    </h2>
    
    <div class="class-cards-grid">
      {classDetails.map((info) => (
        <div class="class-card">
          <div class="class-img-wrapper">
            <img src={info.image} alt={info.title} class="class-img" onerror="this.style.display='none'" />
          </div>
          
          <div class="class-card-content">
            <h3>{info.title}</h3>
            <span class="professors">{info.professors}</span>
            <p>{info.description}</p>
          </div>
        </div>
      ))}
    </div>

  </section>
</MainLayout>

<style>
  .class-cards-grid {
    display: grid;
    /* This automatically makes it 1 column on phones, 2 on tablets, and 3 on big screens! */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
    margin-bottom: 100px;
  }

  .class-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 43, 92, 0.08); /* Matches your project's shadow vibe */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .class-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 43, 92, 0.15);
  }

  .class-img-wrapper {
    width: 100%;
    height: 220px;
    background-color: #eaeaea; /* Light gray placeholder until you add real images */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .class-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .class-card-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .class-card-content h3 {
    color: var(--navy);
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .professors {
    color: var(--cyan);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    border-bottom: 2px solid var(--yellow); /* Adds that cool surfboard yellow touch */
    padding-bottom: 8px;
    display: inline-block;
    align-self: flex-start;
  }

  .class-card-content p {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>